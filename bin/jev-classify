#!/usr/bin/env python3
"""Classify email rows with Jev in two rounds. Reads JSONL rows (id, sender, subject, snippet) on stdin. Writes JSONL rows (id, domain, domain_confidence, subtype, subtype_confidence, health, child, money) on stdout."""
import json
import sys
import urllib.request
from pathlib import Path

URL = "https://api.typesafe.ai/v1/systemone"
KEY_FILE = Path.home() / ".config/typesafe/api-key"

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from kb import areas

DOMAINS = areas.choices(other="Marketing, newsletters, social media, shopping offers or anything else.")
SUBTYPES = areas.kinds()

def ask(state, questions):
    body = {"state": state, "model": "jev-latest", "questions": questions}
    request = urllib.request.Request(
        URL,
        data=json.dumps(body).encode(),
        headers={
            "Authorization": "Bearer " + KEY_FILE.read_text().strip(),
            "Content-Type": "application/json",
        },
    )
    with urllib.request.urlopen(request, timeout=60) as response:
        return json.load(response)["answers"]


def classify(row):
    state = {"email": f"From: {row['sender']}\nSubject: {row['subject']}\n{row['snippet']}"}
    first = ask(
        state,
        {
            "domain": {"type": "choice", "instructions": "Which household area fits the `email`?", "criteria": DOMAINS},
            "health": {"type": "noul", "instructions": "The `email` contains health information about a person."},
            "child": {"type": "noul", "instructions": "The `email` concerns a child."},
            "money": {"type": "noul", "instructions": "The `email` states a payment amount or price."},
        },
    )
    domain = first["domain"]["choice"]
    result = {
        "id": row["id"],
        "domain": domain,
        "domain_confidence": first["domain"]["confidence"],
        "health": first["health"]["noul"],
        "child": first["child"]["noul"],
        "money": first["money"]["noul"],
        "subtype": None,
        "subtype_confidence": None,
    }
    if domain in SUBTYPES:
        second = ask(
            state,
            {"subtype": {"type": "choice", "instructions": f"Which kind of {domain} email is the `email`?", "criteria": SUBTYPES[domain]}},
        )["subtype"]
        result["subtype"] = second["choice"]
        result["subtype_confidence"] = second["confidence"]
    return result


for line in sys.stdin:
    if line.strip():
        print(json.dumps(classify(json.loads(line))), flush=True)
