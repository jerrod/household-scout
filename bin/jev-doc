#!/usr/bin/env python3
"""Triage files by path. Reads JSONL rows (id, path, ext, text) on stdin. Writes JSONL rows (id, area, confidence)."""
import json
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO))

from kb.doc_area import triage  # noqa: E402

rows = [json.loads(line) for line in sys.stdin if line.strip()]
for result in triage(rows):
    print(json.dumps(result), flush=True)
