#!/bin/zsh
# Folds repeated facts into one fact with every date, then checks, commits and pushes.
set -u
cd "$(dirname "$0")/.."
bin/kb-guard || exit 1
until mkdir /tmp/kb-worker.lock 2>/dev/null; do sleep 30; done
trap 'rm -rf /tmp/kb-worker.lock 2>/dev/null' EXIT
git pull -q --rebase --autostash origin "${KB_BRANCH:-main}" || exit 1
python3 -I kb/recurring.py || exit 1
bin/kb check > /tmp/kb-fold-check.txt 2>&1 || exit 1
bin/test > /tmp/kb-fold-test.txt 2>&1 || exit 1
git add facts documents/fact-links.csv
git commit -q -m "Fold repeated facts into one fact with every date" || exit 0
for attempt in 1 2 3; do git pull -q --rebase origin "${KB_BRANCH:-main}" && git push -q origin "${KB_BRANCH:-main}" && exit 0; sleep 20; done
exit 1
